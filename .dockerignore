# Never bake secrets into the image
.env

# No need to copy these into the image
.venv
.git
.gitignore
__pycache__
*.pyc
*.pyo
*.pyd
*.log

# Debug/temporary text files only (NOT requirements.txt!)
debug_*.txt
autofill_debug.txt
ocr_debug.txt
ocr_debug*.txt
migration_error.log

# Dev/scratch files
scratch/
.scratch/
unused_files/

# Docs
docs/
README.md
